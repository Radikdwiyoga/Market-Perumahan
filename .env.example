APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Deploy produksi (mis. Alwaysdata Free) ---
# Pengembangan lokal tetap SQLite (baris di atas). Untuk produksi, aktifkan MySQL:
# DB_CONNECTION=mysql
# DB_HOST=mysql-<akun>.alwaysdata.net
# DB_PORT=3306
# DB_DATABASE=<akun>_market
# DB_USERNAME=<akun>_market
# DB_PASSWORD=<isi dari panel Alwaysdata>
# QUEUE_CONNECTION=sync   # tanpa queue worker di hosting gratis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Proxy tepercaya untuk membaca X-Forwarded-For/IP asli. Kosongkan ("") di
# produksi bila aplikasi diakses langsung tanpa proxy, atau isi daftar IP proxy
# (mis. "10.0.0.1,10.0.0.2") agar rate limiter tidak bisa dilewati dengan
# memalsukan header. Nilai default "*" hanya aman untuk pengembangan lokal.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Marketplace: backup harian (PRD §74) ---
# Retention snapshot site:backup dalam hari (contoh PRD: 7 / 30 / 90).
BACKUP_RETENTION_DAYS=90

# --- Marketplace: notifikasi real-time (PRD §70) ---
# REALTIME_MAX_WAIT=25
# REALTIME_POLL_INTERVAL=3
# REALTIME_LIMIT_PER_MINUTE=120

# --- Marketplace: deskripsi produk otomatis dengan AI (Google AI Studio) ---
# Ambil API key gratis di https://aistudio.google.com/apikey
# Kosongkan (atau hapus baris ini) untuk mematikan fitur AI.
GOOGLE_AI_API_KEY=
# Model vision yang dipakai. Catatan: gemini-2.5-* sudah tidak tersedia untuk akun baru.
GOOGLE_AI_MODEL=gemini-3.8-flash
# Batas permintaan "Buat dengan AI" per menit per penjual.
AI_DESCRIPTION_LIMIT_PER_MINUTE=6
# Batas waktu pembayaran sebelum pesanan dibatalkan otomatis (menit).
PAYMENT_EXPIRY_MINUTES=15

VITE_APP_NAME="${APP_NAME}"
